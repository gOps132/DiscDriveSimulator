@using System.Linq
@using DiscDriveSimulator.Models
@using DiscDriveSimulator.Services
@inject ISimulationService Sim
@inject StorageService Storage

@if (IsOpen)
{
    // Same 100/page window as storage. A permissive run can keep thousands of discs, and
    // rendering them all at once is what made the obtain grid unusable.
    var totalPages = PagerState.TotalPages(Discs.Count);
    currentPage = PagerState.ClampPage(currentPage, totalPages);

    var (skip, take) = PagerState.PageWindow(Discs.Count, currentPage);
    var pageDiscs = skip < Discs.Count
        ? Discs.GetRange(skip, take)
        : new List<Disc>();
    var (rangeStart, rangeEnd) = PagerState.RangeLabel(Discs.Count, currentPage);

    <div class="modal-backdrop-overlay obtain-backdrop" @onclick="Close">
        <div class="zzz-modal-window obtain-modal-window" data-watermark="@Source" @onclick:stopPropagation="true">
            <div class="zzz-modal-header">
                <div class="zzz-modal-title-group">
                    <div class="zzz-modal-title">Obtain</div>
                    @if (RunSummary != null && (RunSummary.TotalDrops > 0 || RunSummary.DropRecords.Count > 0 || RunSummary.GeneratedDiscs.Count > 0))
                    {
                        var keptCount = RunSummary.KeptDiscs.Count > 0 ? RunSummary.KeptDiscs.Count : RunSummary.DropRecords.Count(r => r.IsKept);
                        if (keptCount == 0 && RunSummary.DropRecords.Count == 0) { keptCount = Discs.Count; }
                        var dismantledCount = RunSummary.DismantledCount > 0 ? RunSummary.DismantledCount : RunSummary.DropRecords.Count(r => !r.IsKept);
                        <div class="zzz-modal-counts-sub">
                            <span class="count-kept">@keptCount Kept</span>
                            @if (dismantledCount > 0)
                            {
                                <span class="count-dismantled">• @dismantledCount Dismantled (+@dismantledCount Master Copies)</span>
                            }
                        </div>
                    }
                </div>
                <button type="button" class="zzz-close-btn" @onclick="Close" title="Close">
                    <img src="assets/IconCancel.png" alt="Close" />
                </button>
            </div>

            <div class="obtain-body grid w-full">
                <!-- Left 6-Column Disc Grid Section -->
                <div class="obtain-left-section flex min-h-0 flex-col overflow-hidden">
                    <div class="obtain-subtitle">Use @(RunSummary?.Runs ?? 1) times to obtain:</div>
                    <div class="obtain-disc-grid grid content-start overflow-x-hidden overflow-y-auto">
                        @foreach (var disc in pageDiscs)
                        {
                            var isSelected = inspectedDisc?.Id == disc.Id;
                            var record = RunSummary?.DropRecords.FirstOrDefault(r => r.Disc != null && r.Disc.Id == disc.Id);
                            var isDismantled = record != null && !record.IsKept;
                            <div class="s-rank-disc-card flex cursor-pointer flex-col items-center @(isSelected ? "selected" : "")"
                                 @key="disc.Id"
                                 @onclick="() => SelectDisc(disc)">
                                <DiscSlot Disc="disc" IsSelected="isSelected" IsDismantled="isDismantled" Size="80px" />
                                <span class="obtain-item-qty text-center font-display text-sm leading-none font-black text-white">1</span>
                            </div>
                        }
                    </div>
                    <Pager CurrentPage="currentPage"
                           TotalPages="totalPages"
                           RangeStart="rangeStart"
                           RangeEnd="rangeEnd"
                           TotalCount="Discs.Count"
                           AriaLabel="Obtained discs pages"
                           OnPageChanged="GoToPage" />
                </div>

                <!-- Right Detail Panel (Templatized Reusable ZZZ Component) -->
                @{
                    var inspectedRecord = RunSummary?.DropRecords.FirstOrDefault(r => r.Disc != null && r.Disc.Id == inspectedDisc?.Id);
                    var modalDiscIsDismantled = inspectedRecord != null && !inspectedRecord.IsKept;
                    var discPriorities = inspectedDisc != null
                        ? Sim.State.GetPrioritizedSubstatsForPartition(inspectedDisc.Partition)
                        : null;
                    var statusMsg = inspectedRecord != null
                        ? (modalDiscIsDismantled ? $"Auto-Dismantled: {inspectedRecord.DismantleReason}" : "Kept in Inventory")
                        : null;
                }
                <DiscDetailCard Disc="inspectedDisc"
                                DesiredStats="discPriorities"
                                StatusText="@statusMsg"
                                IsDismantled="modalDiscIsDismantled"
                                OnLockToggle="ToggleLock"
                                OnDismantle="DismantleDisc" />
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public string Source { get; set; } = "ROUTINE";
    [Parameter] public List<Disc> Discs { get; set; } = new();
    [Parameter] public SimulationRunResult? RunSummary { get; set; }

    private Disc? inspectedDisc;
    private int currentPage = 1;
    private bool wasOpen;

    protected override void OnParametersSet()
    {
        if (IsOpen)
        {
            bool valid = inspectedDisc != null && Discs.Any(d => d.Id == inspectedDisc.Id);
            if (!valid)
            {
                inspectedDisc = Discs.FirstOrDefault();
                currentPage = 1;
            }
            else if (!wasOpen)
            {
                // Jump to the inspected disc's page, but only on open. Doing this on every
                // render would snap the player back whenever they paged away deliberately.
                int index = Discs.FindIndex(d => d.Id == inspectedDisc.Id);
                if (index >= 0) currentPage = PagerState.PageForIndex(index);
            }
        }
        wasOpen = IsOpen;
    }

    private void SelectDisc(Disc disc)
    {
        inspectedDisc = disc;
    }

    private void GoToPage(int page)
    {
        currentPage = PagerState.ClampPage(page, PagerState.TotalPages(Discs.Count));
    }

    private async Task DismantleDisc(Disc disc)
    {
        if (Sim.DismantleDisc(disc))
        {
            Discs.Remove(disc);
            // Clamp rather than reset: dismantling shrinks the list, which can drop the last
            // page out from under the player, but staying put is less jarring than jumping.
            // The inspected disc then becomes the first of the visible page, so the detail
            // panel never shows a disc the grid is not displaying.
            currentPage = PagerState.ClampPage(currentPage, PagerState.TotalPages(Discs.Count));
            var (skip, take) = PagerState.PageWindow(Discs.Count, currentPage);
            inspectedDisc = take > 0 ? Discs[skip] : null;
            await SaveState();
        }
    }

    private async Task ToggleLock(Disc disc)
    {
        disc.IsLocked = !disc.IsLocked;
        await SaveState();
        Sim.NotifyStateChanged();
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }

    private async Task SaveState()
    {
        await Storage.SaveStateAsync(Sim.State);
    }
}
