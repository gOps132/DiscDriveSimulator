@using System.Linq
@using DiscDriveSimulator.Models
@using DiscDriveSimulator.Services
@inject ISimulationService Sim
@inject StorageService Storage

@if (IsOpen)
{
    // One pass over the inventory for the filtered list and both batch counts. On a full
    // storage this used to be five filter-and-sort passes per render, which dominated
    // frame time and made every click feel dead.
    var view = Sim.GetStorageView();
    var filteredDiscs = view.FilteredDiscs;
    var nonMatchingCount = view.NonMatchingDismantleableCount;
    var selectedCount = view.SelectedCount;

    // Render one page at a time. The full grid is up to MaxInventoryDiscs cards, each a
    // DiscSlot component plus an image; building all of them at once is what makes a full
    // storage unusable. Filtering and sorting still run over the whole set, so pages are
    // just a window onto the same ordered list.
    // Clamp before paging so a shrunk list cannot leave us past the end.
    var totalPages = Math.Max(1, (int)Math.Ceiling(filteredDiscs.Count / (double)DiscsPerPage));
    if (currentPage > totalPages) currentPage = totalPages;
    if (currentPage < 1) currentPage = 1;

    var skip = (currentPage - 1) * DiscsPerPage;
    var pageDiscs = skip < filteredDiscs.Count
        ? filteredDiscs.GetRange(skip, Math.Min(DiscsPerPage, filteredDiscs.Count - skip))
        : new List<Disc>();
    var rangeStart = pageDiscs.Count == 0 ? 0 : skip + 1;
    var rangeEnd = skip + pageDiscs.Count;

    <div class="modal-backdrop-overlay" @onclick="Close">
        <div class="zzz-modal-window storage-modal-window" data-watermark="INVENTORY" @onclick:stopPropagation="true">
            <!-- Modal Header -->
            <div class="zzz-modal-header flex items-center justify-between">
                <div class="zzz-modal-title-group flex items-center">
                    <img src="assets/Icon_Storage.webp" alt="Storage" class="zzz-modal-title-icon" />
                    <span class="zzz-modal-title">Drive Disc Storage</span>
                    <span class="zzz-count-pill">@filteredDiscs.Count / @Sim.State.Inventory.Count</span>
                </div>
                <button type="button" class="zzz-close-btn" @onclick="Close" title="Close">
                    <img src="assets/IconCancel.png" alt="Close" />
                </button>
            </div>

            <!-- Filter & Action Toolbar -->
            <div class="storage-toolbar flex flex-col">
                <div class="storage-filters-row flex flex-wrap items-center">
                    <!-- Partition Filter Pills -->
                    <div class="filter-pill-group flex items-center">
                        <span class="filter-label">Partition:</span>
                        <button type="button" class="filter-pill @(Sim.State.FilterPartition == null ? "active" : "")"
                                @onclick="() => SetPartitionFilter(null)">All</button>
                        @for (int p = 1; p <= 6; p++)
                        {
                            var part = p;
                            <button type="button" class="filter-pill @(Sim.State.FilterPartition == part ? "active" : "")"
                                    @onclick="() => SetPartitionFilter(part)">@part</button>
                        }
                    </div>

                    <!-- Set Filter -->
                    <div class="filter-pill-group flex items-center">
                        <span class="filter-label">Set:</span>
                        <select class="storage-select" value="@(Sim.State.FilterSet?.ToString() ?? "")" @onchange="OnSetFilterChanged">
                            <option value="">All Sets</option>
                            @foreach (var setVal in Enum.GetValues<DiscSet>())
                            {
                                <option value="@setVal">@Disc.FormatSetName(setVal)</option>
                            }
                        </select>
                    </div>

                    <!-- Lock Filter -->
                    <div class="filter-pill-group flex items-center">
                        <span class="filter-label">Lock:</span>
                        <button type="button" class="filter-pill @(Sim.State.FilterLock == null ? "active" : "")"
                                @onclick="() => SetLockFilter(null)">All</button>
                        <button type="button" class="filter-pill @(Sim.State.FilterLock == true ? "active" : "")"
                                @onclick="() => SetLockFilter(true)">Locked</button>
                        <button type="button" class="filter-pill @(Sim.State.FilterLock == false ? "active" : "")"
                                @onclick="() => SetLockFilter(false)">Unlocked</button>
                    </div>

                    <!-- Sort Dropdown -->
                    <div class="filter-pill-group flex items-center">
                        <span class="filter-label">Sort:</span>
                        <select class="storage-select" value="@Sim.State.CurrentSort" @onchange="OnSortChanged">
                            <option value="@SortOrder.HighestCv">Highest CV</option>
                            <option value="@SortOrder.HighestRv">Highest RV</option>
                            <option value="@SortOrder.PartitionAsc">Partition (1 → 6)</option>
                            <option value="@SortOrder.PartitionDesc">Partition (6 → 1)</option>
                            <option value="@SortOrder.Newest">Newest</option>
                        </select>
                    </div>
                </div>

                <!-- Batch Actions Row -->
                <div class="storage-actions-row">
                    <div class="batch-select-btns">
                        <button type="button" class="btn-storage-tool" @onclick="SelectAllUnlocked">Select All</button>
                        <button type="button" class="btn-storage-tool" @onclick="DeselectAll">Deselect All</button>
                    </div>

                    <div class="batch-dismantle-btns">
                        <button type="button" class="btn-storage-dismantle"
                                disabled="@(selectedCount == 0)"
                                @onclick="DismantleSelectedDiscs">
                            Dismantle Selected (@selectedCount)
                        </button>
                        <button type="button" class="btn-storage-dismantle warning"
                                disabled="@(nonMatchingCount == 0)"
                                @onclick="DismantleNonMatchingDiscs">
                            Dismantle Non-Matching (@nonMatchingCount)
                        </button>
                    </div>
                </div>
            </div>

            <!-- Storage Body: Grid on Left, Inspector on Right -->
            <div class="storage-body">
                <!-- Left Grid -->
                <div class="storage-grid-container">
                    @if (filteredDiscs.Count == 0)
                    {
                        <div class="storage-empty-state">
                            <img src="assets/Icon_Storage.webp" alt="Empty" class="empty-icon" />
                            <p class="empty-text">No Drive Discs found in storage.</p>
                            <span class="empty-sub">Tune partitions on the console or run cleanup simulations.</span>
                        </div>
                    }
                    else
                    {
                        <div class="storage-disc-grid">
                            @foreach (var disc in pageDiscs)
                            {
                                var isInspected = inspectedStorageDisc?.Id == disc.Id;
                                <div class="storage-disc-card @(isInspected ? "inspected" : "") @(disc.IsSelected ? "batch-selected" : "")"
                                     @key="disc.Id"
                                     @onclick="() => SelectStorageDisc(disc)">
                                    <!-- Disc Slot Art & Corner Overlays -->
                                    <div class="storage-disc-slot-container">
                                        <DiscSlot Disc="disc" Size="96px" />
                                        <div class="disc-card-overlays">
                                            @if (disc.IsLocked)
                                            {
                                                <img src="assets/Icon_Locked_03.png" alt="Locked" class="disc-lock-indicator" />
                                            }
                                            <label class="disc-batch-checkbox-wrap" @onclick:stopPropagation="true">
                                                <input type="checkbox"
                                                       class="disc-batch-checkbox"
                                                       checked="@disc.IsSelected"
                                                       disabled="@disc.IsLocked"
                                                       @onchange="(e) => ToggleDiscSelection(disc, e)" />
                                            </label>
                                        </div>
                                    </div>

                                    <!-- Main Stat Snippet -->
                                    <div class="disc-card-mainstat">
                                        @Disc.FormatStatName(disc.MainStat)
                                    </div>

                                    <!-- CV / RV Badges -->
                                    <div class="disc-card-scores">
                                        <span class="score-cv-chip">CV @disc.GetCritValue().ToString("0.#")</span>
                                        <span class="score-rv-chip">RV @disc.GetRollValue(Sim.State.DesiredStats)/4</span>
                                    </div>
                                </div>
                            }
                        </div>

                        @if (totalPages > 1)
                        {
                            <div class="storage-pager" role="navigation" aria-label="Storage pages">
                                <button type="button" class="btn-pager-nav"
                                        disabled="@(currentPage <= 1)"
                                        @onclick="() => GoToPage(currentPage - 1)"
                                        aria-label="Previous page">&#8249;</button>

                                <span class="storage-pager-status">
                                    Page @currentPage of @totalPages
                                    <span class="storage-pager-range">
                                        &middot; showing @rangeStart&ndash;@rangeEnd of @filteredDiscs.Count
                                    </span>
                                </span>

                                <button type="button" class="btn-pager-nav"
                                        disabled="@(currentPage >= totalPages)"
                                        @onclick="() => GoToPage(currentPage + 1)"
                                        aria-label="Next page">&#8250;</button>
                            </div>
                        }
                    }
                </div>

                <!-- Right Inspector (Templatized Reusable ZZZ Component) -->
                <DiscDetailCard Disc="inspectedStorageDisc"
                                DesiredStats="Sim.State.DesiredStats"
                                EmptyText="Select a disc to inspect"
                                OnLockToggle="ToggleLock"
                                OnDismantle="DismantleSingleDisc" />
            </div>
        </div>
    </div>
}

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }

    private Disc? inspectedStorageDisc;

    /// <summary>Cards rendered per page. Keeps the grid light enough to stay interactive.</summary>
    private const int DiscsPerPage = 100;

    private int currentPage = 1;

    protected override void OnParametersSet()
    {
        if (IsOpen)
        {
            EnsureValidInspectedDisc();
        }
    }

    private void GoToPage(int page)
    {
        currentPage = Math.Max(1, page);
    }

    /// <summary>
    /// Keeps the inspected disc valid after inventory or filter changes.
    /// </summary>
    /// <remarks>
    /// Uses reference equality for the membership checks. Identity lookups by
    /// <see cref="Disc.Id"/> meant a full inventory scan on every filter change, and the
    /// filtered list holds the same <see cref="Disc"/> instances that inventory does, so
    /// <see cref="object.ReferenceEquals"/> is both correct and O(n) at worst with no
    /// delegate allocation.
    /// </remarks>
    private void EnsureValidInspectedDisc()
    {
        var filtered = Sim.GetFilteredDiscs();

        if (inspectedStorageDisc == null ||
            !Sim.State.Inventory.Any(d => ReferenceEquals(d, inspectedStorageDisc)))
        {
            // Inspected disc is gone entirely (dismantled, or never set).
            inspectedStorageDisc = filtered.Count > 0 ? filtered[0] : Sim.State.Inventory.FirstOrDefault();
        }
        else if (!filtered.Any(d => ReferenceEquals(d, inspectedStorageDisc)) && filtered.Count > 0)
        {
            // Still owned, but filtered out, so fall back to the first match.
            inspectedStorageDisc = filtered[0];
        }
    }

    private async Task Close()
    {
        await OnClose.InvokeAsync();
    }

    private void SelectStorageDisc(Disc disc)
    {
        inspectedStorageDisc = disc;
    }

    private void ToggleDiscSelection(Disc disc, ChangeEventArgs e)
    {
        disc.IsSelected = (bool)(e.Value ?? false);
    }

    private void SelectAllUnlocked()
    {
        // Deliberately every match, not just the visible page: the button reads "Select All"
        // and partial-page selection would silently surprise players on a paginated grid.
        foreach (var d in Sim.GetFilteredDiscs())
        {
            if (!d.IsLocked) d.IsSelected = true;
        }
    }

    private void DeselectAll()
    {
        foreach (var d in Sim.State.Inventory)
        {
            d.IsSelected = false;
        }
    }

    private async Task DismantleSelectedDiscs()
    {
        var selected = Sim.State.Inventory.Where(d => d.IsSelected && !d.IsLocked).ToList();
        if (selected.Count > 0)
        {
            Sim.DismantleDiscs(selected);
            ResetPaging();
            EnsureValidInspectedDisc();
            await SaveState();
        }
    }

    private async Task DismantleNonMatchingDiscs()
    {
        int dismantled = Sim.DismantleNonMatching();
        if (dismantled > 0)
        {
            ResetPaging();
            EnsureValidInspectedDisc();
            await SaveState();
        }
    }

    private async Task DismantleSingleDisc(Disc disc)
    {
        if (Sim.DismantleDisc(disc))
        {
            ResetPaging();
            EnsureValidInspectedDisc();
            await SaveState();
        }
    }

    private async Task ToggleLock(Disc disc)
    {
        disc.IsLocked = !disc.IsLocked;
        if (disc.IsLocked)
        {
            disc.IsSelected = false;
        }
        await SaveState();
        Sim.NotifyStateChanged();
    }

    private async Task SetPartitionFilter(int? partition)
    {
        Sim.State.FilterPartition = partition;
        ResetPaging();
        EnsureValidInspectedDisc();
        await SaveState();
    }

    private async Task SetLockFilter(bool? isLocked)
    {
        Sim.State.FilterLock = isLocked;
        ResetPaging();
        EnsureValidInspectedDisc();
        await SaveState();
    }

    private async Task OnSetFilterChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        Sim.State.FilterSet = string.IsNullOrEmpty(val) ? null : Enum.Parse<DiscSet>(val);
        ResetPaging();
        EnsureValidInspectedDisc();
        await SaveState();
    }

    private async Task OnSortChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<SortOrder>(e.Value?.ToString(), out var sort))
        {
            Sim.State.CurrentSort = sort;
            ResetPaging();
            EnsureValidInspectedDisc();
            await SaveState();
        }
    }

    /// <summary>
    /// Returns to page 1 after the result set changes shape.
    /// </summary>
    /// <remarks>
    /// Filtering or re-sorting reorders the whole list, so staying on page 7 would show an
    /// arbitrary slice of the new results. Dismantling also shrinks the list, which can drop
    /// the last page out from under the player.
    /// </remarks>
    private void ResetPaging()
    {
        currentPage = 1;
    }

    private async Task SaveState()
    {
        await Storage.SaveStateAsync(Sim.State);
    }
}
