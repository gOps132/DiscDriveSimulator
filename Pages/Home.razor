@page "/"
@using DiscDriveSimulator.Models
@using DiscDriveSimulator.Services
@inject ISimulationService Sim
@inject StorageService Storage

<PageTitle>Drive Disc Simulator</PageTitle>

<div class="tuning-screen" tabindex="0" @onkeydown="HandleKeyDown" @ref="tuningScreenRef">
    <!-- Top Header Bar -->
    <header class="tuning-header">
        <div class="header-actions-left">
            <button type="button" class="header-icon-btn" title="Reset &amp; Restore Initial State" @onclick="ResetInitial">
                <img src="assets/IconLoadingBig.png" alt="Reset" />
            </button>
            <button type="button" class="header-icon-btn" title="View All Stored Discs" @onclick="OpenStorageModal">
                <img src="assets/Icon_Storage.webp" alt="Storage" />
            </button>
        </div>

        <div class="header-currencies-right">
            <!-- Battery Charge Counter -->
            <div class="currency-pill">
                <input type="text"
                       inputmode="numeric"
                       class="currency-input"
                       maxlength="8"
                       value="@batteryInputStr"
                       @oninput="e => batteryInputStr = e.Value?.ToString() ?? string.Empty"
                       @onblur="CommitBattery"
                       @onkeydown="e => HandleCurrencyKeyDown(e, CommitBattery)"
                       @onkeydown:stopPropagation="true"
                       onfocus="this.select()"
                       title="Battery Charge (Editable)" />
                <img class="currency-icon" src="assets/Item_Battery_Charge.webp" alt="Battery" />
            </div>

            <!-- Ether Battery Counter -->
            <div class="currency-pill">
                <input type="text"
                       inputmode="numeric"
                       class="currency-input"
                       maxlength="8"
                       value="@etherInputStr"
                       @oninput="e => etherInputStr = e.Value?.ToString() ?? string.Empty"
                       @onblur="CommitEther"
                       @onkeydown="e => HandleCurrencyKeyDown(e, CommitEther)"
                       @onkeydown:stopPropagation="true"
                       onfocus="this.select()"
                       title="Ether Battery (Editable)" />
                <img class="currency-icon" src="assets/Item_Ether_Battery.webp" alt="Ether Battery" />
            </div>

            <!-- Hi-Fi Master Copy Counter -->
            <div class="currency-pill">
                <input type="text"
                       inputmode="numeric"
                       class="currency-input"
                       maxlength="8"
                       value="@hifiInputStr"
                       @oninput="e => hifiInputStr = e.Value?.ToString() ?? string.Empty"
                       @onblur="CommitHiFi"
                       @onkeydown="e => HandleCurrencyKeyDown(e, CommitHiFi)"
                       @onkeydown:stopPropagation="true"
                       onfocus="this.select()"
                       title="Hi-Fi Master Copies (Editable)" />
                <img class="currency-icon" src="assets/Item_Hi-Fi_Master_Copy.webp" alt="Hi-Fi Master Copy" />
            </div>
        </div>
    </header>

    <!-- Main Content Area -->
    <div class="tuning-main-content">
        <!-- Left Column: Routine Cleanup Console & Partition Info -->
        <div class="left-station-column">
            <!-- Routine Cleanup Simulation Console -->
            <section class="routine-cleanup-card">
                <div class="routine-card-header">
                    <div class="routine-title-box">
                        <img src="assets/Item_Battery_Charge.webp" alt="Battery" class="routine-header-icon" />
                        <span class="routine-title">Routine Cleanup</span>
                    </div>
                </div>

                <!-- Stage Selection -->
                <div class="stage-selector-box">
                    <div class="stage-selector-header">
                        <span class="stage-selector-label">Target Stage:</span>
                        <select class="stage-dropdown" value="@Sim.State.SelectedCleanupStageId" @onchange="OnStageChanged">
                            @foreach (var stage in RoutineCleanupStage.AllStages)
                            {
                                <option value="@stage.Id">@stage.Name</option>
                            }
                        </select>
                    </div>
                    @{
                        var currentStage = GetCurrentStage();
                    }
                    <div class="stage-badges-row">
                        <div class="stage-set-badge">
                            <span class="badge-dot"></span>
                            <span class="badge-name">@Disc.FormatSetName(currentStage.Set1)</span>
                        </div>
                        <div class="stage-set-badge">
                            <span class="badge-dot"></span>
                            <span class="badge-name">@Disc.FormatSetName(currentStage.Set2)</span>
                        </div>
                    </div>
                </div>

                <!-- Daily Coffee Switch -->
                <div class="coffee-switch-box">
                    <label class="coffee-toggle">
                        <input type="checkbox" checked="@Sim.State.WithDailyCoffee" @onchange="OnCoffeeToggleChanged" />
                        <span class="coffee-slider"></span>
                        <span class="coffee-label">
                            With daily coffee (+60 <img src="assets/Item_Battery_Charge.webp" alt="Charge" class="inline-battery-icon" /> / day)
                        </span>
                    </label>
                </div>

                <!-- Quick Bulk Presets -->
                <div class="preset-buttons-grid">
                    <button type="button" class="btn-preset" @onclick="() => ApplyPreset(1)">
                        <span class="preset-name">1 Day</span>
                        <span class="preset-sub">@(Sim.State.WithDailyCoffee ? "300" : "240")</span>
                    </button>
                    <button type="button" class="btn-preset" @onclick="() => ApplyPreset(7)">
                        <span class="preset-name">1 Week</span>
                        <span class="preset-sub">@(Sim.State.WithDailyCoffee ? "2,100" : "1,680")</span>
                    </button>
                    <button type="button" class="btn-preset" @onclick="() => ApplyPreset(21)">
                        <span class="preset-name">3 Weeks</span>
                        <span class="preset-sub">@(Sim.State.WithDailyCoffee ? "6,300" : "5,040")</span>
                    </button>
                    <button type="button" class="btn-preset" @onclick="() => ApplyPreset(30)">
                        <span class="preset-name">1 Month</span>
                        <span class="preset-sub">@(Sim.State.WithDailyCoffee ? "9,000" : "7,200")</span>
                    </button>
                </div>

                <!-- Stamina & Runs Calculation Box -->
                <div class="stamina-summary-box">
                    <div class="stamina-line">
                        <span class="stamina-label">TOTAL RUNS AVAILABLE</span>
                        <span class="stamina-runs-val">@GetTotalCalculatedRuns() Runs</span>
                    </div>
                    <div class="stamina-sub-details">
                        <span>Charge: @Sim.State.BatteryCharge</span>
                        <span>+ Ether Reserve: @(Sim.State.EtherBatteries * 60)</span>
                    </div>
                </div>

                <!-- Automation Settings -->
                <div class="automation-settings-box">
                    <label class="automation-toggle">
                        <input type="checkbox" @bind="Sim.State.AutoDismantleOnSim" />
                        <span>Auto-dismantle non-matching drops</span>
                    </label>
                </div>

                <!-- Single Primary Execution Button -->
                <button type="button" class="btn-run-simulation"
                        disabled="@(GetTotalCalculatedRuns() == 0)"
                        @onclick="RunRoutineCleanup">
                    <span class="btn-sim-text">Start Cleanup</span>
                    <div class="btn-sim-cost">
                        <img src="assets/Item_Battery_Charge.webp" alt="Cost" class="btn-battery-icon" />
                        <span>@(GetTotalCalculatedRuns() * 60)</span>
                    </div>
                </button>

                <!-- Bulk Run Result Summary Banner (if executed) -->
                @if (lastRunSummary != null)
                {
                    <div class="run-summary-banner">
                        <div class="summary-topline">
                            <span class="summary-runs">Completed @lastRunSummary.Runs Runs</span>
                        </div>
                        <div class="summary-stats-grid">
                            <div class="sum-stat">
                                <span class="sum-label">DROPS</span>
                                <span class="sum-val">@lastRunSummary.GeneratedDiscs.Count</span>
                            </div>
                            <div class="sum-stat">
                                <span class="sum-label">KEPT</span>
                                <span class="sum-val highlight">@lastRunSummary.KeptDiscs.Count</span>
                            </div>
                            <div class="sum-stat">
                                <span class="sum-label">DISMANTLED</span>
                                <span class="sum-val">@lastRunSummary.DismantledCount</span>
                            </div>
                            <div class="sum-stat">
                                <span class="sum-label">AVG CV</span>
                                <span class="sum-val">@lastRunSummary.AverageCv</span>
                            </div>
                        </div>
                    </div>
                }

                <!-- Lifetime Farming Statistics -->
                <div class="routine-lifetime-stats">
                    <div class="lifetime-stat-item">
                        <span class="lbl">Runs</span>
                        <span class="val">@Sim.State.TotalRuns</span>
                    </div>
                    <div class="lifetime-stat-item">
                        <span class="lbl">Spent</span>
                        <span class="val">@Sim.State.TotalBatterySpent</span>
                    </div>
                    <div class="lifetime-stat-item">
                        <span class="lbl">Drops</span>
                        <span class="val">@Sim.State.TotalDiscsDropped</span>
                    </div>
                    <div class="lifetime-stat-item">
                        <span class="lbl">Dismantled</span>
                        <span class="val">@Sim.State.TotalDiscsDismantled</span>
                    </div>
                </div>
            </section>

            <!-- Center-Left Floating Partition Info Card -->
            <aside class="partition-info-card">
                <div class="info-title">Partition @selectedPartition (Selected)</div>
                <div class="info-subtitle">Possible Main Stats:</div>
                <ul class="stats-pool-list">
                    @foreach (var stat in GetPossibleMainStats(selectedPartition))
                    {
                        <li>@Disc.FormatStatName(stat)</li>
                    }
                </ul>
            </aside>
        </div>

        <!-- Right Main Console -->
        <main class="tuning-console-panel">
            <div class="console-prompt-banner">
                Press the number to select a Drive Disc partition
            </div>

            <!-- Circular Apparatus with 6 Interactive Sockets -->
            <div class="apparatus-wrapper">
                <img src="assets/Equipment_Menu_Screen.webp" alt="Tuning Apparatus" class="apparatus-bg" />

                @for (int i = 1; i <= 6; i++)
                {
                    var partitionNumber = i;
                    <button type="button"
                            class="socket-node socket-@partitionNumber @(selectedPartition == partitionNumber ? "selected" : "")"
                            title="Partition @partitionNumber"
                            @onclick="() => SelectPartition(partitionNumber)">
                        <span class="socket-label">@partitionNumber</span>
                    </button>
                }
            </div>

            <div class="console-notice-text">
                Guaranteed S-Rank Drive Disc for the selected partition
            </div>

            <!-- Action Buttons: Tune x01 & Tune x10 -->
            <div class="tune-buttons-row">
                <button type="button" class="btn-tune"
                        disabled="@(Sim.State.HiFiMasterCopies < 6)"
                        @onclick="() => TunePartition(1)">
                    <div class="tune-cost-group">
                        <img src="assets/Item_Hi-Fi_Master_Copy.webp" alt="Cost" class="tune-cost-icon" />
                        <span>6</span>
                    </div>
                    <div class="tune-label-group">
                        <span class="tune-sub-text">Tune Partition @selectedPartition</span>
                        <span class="tune-multiplier">x01</span>
                    </div>
                </button>

                <button type="button" class="btn-tune"
                        disabled="@(Sim.State.HiFiMasterCopies < 60)"
                        @onclick="() => TunePartition(10)">
                    <div class="tune-cost-group">
                        <img src="assets/Item_Hi-Fi_Master_Copy.webp" alt="Cost" class="tune-cost-icon" />
                        <span>60</span>
                    </div>
                    <div class="tune-label-group">
                        <span class="tune-sub-text">Tune Partition @selectedPartition</span>
                        <span class="tune-multiplier">x10</span>
                    </div>
                </button>
            </div>
        </main>
    </div>

    <!-- Screen Footer -->
    <footer class="tuning-footer">
        <span>UID: CEDRAKE</span>
    </footer>
</div>

<!-- ==========================================================================
     "OBTAIN" MODAL POPUP
     ========================================================================== -->
@if (showObtainModal)
{
    <div class="modal-backdrop-overlay" @onclick="CloseObtainModal">
        <div class="obtain-modal-window" @onclick:stopPropagation="true">
            <div class="obtain-header">
                <div class="obtain-title">Obtain</div>
                <button type="button" class="obtain-close-btn" @onclick="CloseObtainModal" title="Close">
                    <img src="assets/IconCancel.png" alt="Close" />
                </button>
            </div>

            <div class="obtain-body">
                <!-- Left 5-Column Disc Grid -->
                <div class="obtain-disc-grid">
                    @foreach (var disc in modalDiscs)
                    {
                        var isSelected = inspectedModalDisc?.Id == disc.Id;
                        <div class="s-rank-disc-card @(isSelected ? "selected" : "")"
                             @onclick="() => SelectModalDisc(disc)">
                            <div class="disc-inner-frame">
                                <img src="assets/IconMessageRoleCircle19.png" alt="Disc" class="disc-vinyl-img" />
                                <span class="disc-slot-badge">@disc.Partition</span>
                                <img src="assets/Icon_Item_Rank_S.webp" alt="S-Rank" class="disc-rank-badge" />
                            </div>
                        </div>
                    }
                </div>

                <!-- Right Detail Panel -->
                <div class="obtain-detail-panel">
                    @if (inspectedModalDisc != null)
                    {
                        <div class="detail-title">Partition @inspectedModalDisc.Partition disc</div>
                        <div class="detail-set-title">@Disc.FormatSetName(inspectedModalDisc.Set)</div>

                        <div class="detail-stats-section">
                            <div class="detail-main-stat-box">
                                <div class="main-stat-label">Main Stat</div>
                                <div class="main-stat-value">
                                    @Disc.FormatStatName(inspectedModalDisc.MainStat)
                                    +@Disc.FormatStatValue(inspectedModalDisc.MainStat, inspectedModalDisc.MainStatValue)
                                </div>
                            </div>

                            <div class="detail-substats-box">
                                <div class="detail-substats-header">Substats (@inspectedModalDisc.Substats.Count)</div>
                                <ul class="detail-substats-list">
                                    @foreach (var sub in inspectedModalDisc.Substats)
                                    {
                                        var isDesired = Sim.State.DesiredStats.Contains(sub.Stat);
                                        <li class="detail-substat-item @(isDesired ? "is-desired" : "")">
                                            <span>@(isDesired ? "★ " : "• ")@Disc.FormatStatName(sub.Stat)</span>
                                            <span>+@Disc.FormatStatValue(sub.Stat, sub.Value)</span>
                                        </li>
                                    }
                                </ul>
                            </div>

                            <div class="detail-scores-row">
                                <span class="score-tag cv">CV: @inspectedModalDisc.GetCritValue()</span>
                                <span class="score-tag rv">RV: @inspectedModalDisc.GetRollValue(Sim.State.DesiredStats)/4</span>
                            </div>
                        </div>

                        <div class="detail-actions-row">
                            <button type="button" class="btn-detail" @onclick="() => ToggleLock(inspectedModalDisc)">
                                @(inspectedModalDisc.IsLocked ? "Unlock" : "Lock")
                            </button>
                            <button type="button" class="btn-detail danger"
                                    disabled="@inspectedModalDisc.IsLocked"
                                    @onclick="() => DismantleModalDisc(inspectedModalDisc)">
                                Dismantle (+1)
                            </button>
                        </div>
                    }
                    else
                    {
                        <div style="color: #6b7280; text-align: center; margin-top: 4rem;">
                            No disc selected.
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

<!-- ==========================================================================
     STORAGE & INVENTORY MODAL
     ========================================================================== -->
@if (showStorageModal)
{
    var filteredDiscs = Sim.GetFilteredDiscs();
    var nonMatchingCount = Sim.State.Inventory.Count(d => !d.IsLocked && !Sim.MatchesFilter(d));
    var selectedCount = Sim.State.Inventory.Count(d => d.IsSelected && !d.IsLocked);

    <div class="modal-backdrop-overlay" @onclick="CloseStorageModal">
        <div class="storage-modal-window" @onclick:stopPropagation="true">
            <!-- Modal Header -->
            <div class="storage-header">
                <div class="storage-header-left">
                    <img src="assets/Icon_Storage.webp" alt="Storage" class="storage-title-icon" />
                    <span class="storage-title">Drive Disc Storage</span>
                    <span class="storage-count-pill">@filteredDiscs.Count / @Sim.State.Inventory.Count</span>
                </div>
                <button type="button" class="obtain-close-btn" @onclick="CloseStorageModal" title="Close">
                    <img src="assets/IconCancel.png" alt="Close" />
                </button>
            </div>

            <!-- Filter & Action Toolbar -->
            <div class="storage-toolbar">
                <div class="storage-filters-row">
                    <!-- Partition Filter Pills -->
                    <div class="filter-pill-group">
                        <span class="filter-label">Partition:</span>
                        <button type="button" class="filter-pill @(Sim.State.FilterPartition == null ? "active" : "")"
                                @onclick="() => SetPartitionFilter(null)">All</button>
                        @for (int p = 1; p <= 6; p++)
                        {
                            var part = p;
                            <button type="button" class="filter-pill @(Sim.State.FilterPartition == part ? "active" : "")"
                                    @onclick="() => SetPartitionFilter(part)">@part</button>
                        }
                    </div>

                    <!-- Set Filter -->
                    <div class="filter-pill-group">
                        <span class="filter-label">Set:</span>
                        <select class="storage-select" value="@(Sim.State.FilterSet?.ToString() ?? "")" @onchange="OnSetFilterChanged">
                            <option value="">All Sets</option>
                            @foreach (var setVal in Enum.GetValues<DiscSet>())
                            {
                                <option value="@setVal">@Disc.FormatSetName(setVal)</option>
                            }
                        </select>
                    </div>

                    <!-- Lock Filter -->
                    <div class="filter-pill-group">
                        <span class="filter-label">Lock:</span>
                        <button type="button" class="filter-pill @(Sim.State.FilterLock == null ? "active" : "")"
                                @onclick="() => SetLockFilter(null)">All</button>
                        <button type="button" class="filter-pill @(Sim.State.FilterLock == true ? "active" : "")"
                                @onclick="() => SetLockFilter(true)">Locked</button>
                        <button type="button" class="filter-pill @(Sim.State.FilterLock == false ? "active" : "")"
                                @onclick="() => SetLockFilter(false)">Unlocked</button>
                    </div>

                    <!-- Sort Dropdown -->
                    <div class="filter-pill-group">
                        <span class="filter-label">Sort:</span>
                        <select class="storage-select" value="@Sim.State.CurrentSort" @onchange="OnSortChanged">
                            <option value="@SortOrder.HighestCv">Highest CV</option>
                            <option value="@SortOrder.HighestRv">Highest RV</option>
                            <option value="@SortOrder.PartitionAsc">Partition (1 → 6)</option>
                            <option value="@SortOrder.PartitionDesc">Partition (6 → 1)</option>
                            <option value="@SortOrder.Newest">Newest</option>
                        </select>
                    </div>
                </div>

                <!-- Batch Actions Row -->
                <div class="storage-actions-row">
                    <div class="batch-select-btns">
                        <button type="button" class="btn-storage-tool" @onclick="SelectAllUnlocked">Select All</button>
                        <button type="button" class="btn-storage-tool" @onclick="DeselectAll">Deselect All</button>
                    </div>

                    <div class="batch-dismantle-btns">
                        <button type="button" class="btn-storage-dismantle"
                                disabled="@(selectedCount == 0)"
                                @onclick="DismantleSelectedDiscs">
                            Dismantle Selected (@selectedCount)
                        </button>
                        <button type="button" class="btn-storage-dismantle warning"
                                disabled="@(nonMatchingCount == 0)"
                                @onclick="DismantleNonMatchingDiscs">
                            Dismantle Non-Matching (@nonMatchingCount)
                        </button>
                    </div>
                </div>
            </div>

            <!-- Storage Body: Grid on Left, Inspector on Right -->
            <div class="storage-body">
                <!-- Left Grid -->
                <div class="storage-grid-container">
                    @if (filteredDiscs.Count == 0)
                    {
                        <div class="storage-empty-state">
                            <img src="assets/Icon_Storage.webp" alt="Empty" class="empty-icon" />
                            <p class="empty-text">No Drive Discs found in storage.</p>
                            <span class="empty-sub">Tune partitions on the console or run cleanup simulations.</span>
                        </div>
                    }
                    else
                    {
                        <div class="storage-disc-grid">
                            @foreach (var disc in filteredDiscs)
                            {
                                var isInspected = inspectedStorageDisc?.Id == disc.Id;
                                <div class="storage-disc-card @(isInspected ? "inspected" : "") @(disc.IsSelected ? "batch-selected" : "")"
                                     @onclick="() => SelectStorageDisc(disc)">
                                    <!-- Card Header: Checkbox & Lock Icon -->
                                    <div class="disc-card-topbar">
                                        <input type="checkbox"
                                               class="disc-batch-checkbox"
                                               checked="@disc.IsSelected"
                                               disabled="@disc.IsLocked"
                                               @onclick:stopPropagation="true"
                                               @onchange="(e) => ToggleDiscSelection(disc, e)" />
                                        @if (disc.IsLocked)
                                        {
                                            <img src="assets/Icon_Locked_03.png" alt="Locked" class="disc-lock-indicator" />
                                        }
                                    </div>

                                    <!-- Disc Vinyl Art -->
                                    <div class="storage-disc-vinyl-box">
                                        <img src="assets/IconMessageRoleCircle19.png" alt="Disc" class="disc-vinyl-img" />
                                        <span class="disc-slot-badge">@disc.Partition</span>
                                        <img src="assets/Icon_Item_Rank_S.webp" alt="S-Rank" class="disc-rank-badge" />
                                    </div>

                                    <!-- Main Stat Snippet -->
                                    <div class="disc-card-mainstat">
                                        @Disc.FormatStatName(disc.MainStat)
                                    </div>

                                    <!-- CV / RV Badges -->
                                    <div class="disc-card-scores">
                                        <span class="score-cv-chip">CV @disc.GetCritValue().ToString("0.#")</span>
                                        <span class="score-rv-chip">RV @disc.GetRollValue(Sim.State.DesiredStats)/4</span>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>

                <!-- Right Inspector -->
                <div class="storage-inspector-panel">
                    @if (inspectedStorageDisc != null)
                    {
                        <div class="inspector-card-inner">
                            <div class="inspector-header">
                                <div>
                                    <div class="inspector-disc-title">Partition @inspectedStorageDisc.Partition Disc</div>
                                    <div class="inspector-disc-set">@Disc.FormatSetName(inspectedStorageDisc.Set)</div>
                                </div>
                                <button type="button" class="btn-quick-lock" @onclick="() => ToggleLock(inspectedStorageDisc)"
                                        title="@(inspectedStorageDisc.IsLocked ? "Unlock Disc" : "Lock Disc")">
                                    <img src="@(inspectedStorageDisc.IsLocked ? "assets/Icon_Locked_03.png" : "assets/Icon_Locked_05.png")"
                                         alt="Lock" class="lock-toggle-img" />
                                </button>
                            </div>

                            <div class="inspector-main-stat">
                                <div class="main-stat-label">Main Stat</div>
                                <div class="main-stat-value">
                                    @Disc.FormatStatName(inspectedStorageDisc.MainStat)
                                    <span class="stat-num">+@Disc.FormatStatValue(inspectedStorageDisc.MainStat, inspectedStorageDisc.MainStatValue)</span>
                                </div>
                            </div>

                            <div class="inspector-substats-box">
                                <div class="substats-header-bar">
                                    <span>Substats (@inspectedStorageDisc.Substats.Count)</span>
                                    <span class="desired-legend">★ Desired</span>
                                </div>
                                <ul class="inspector-substats-list">
                                    @foreach (var sub in inspectedStorageDisc.Substats)
                                    {
                                        var isDesired = Sim.State.DesiredStats.Contains(sub.Stat);
                                        <li class="inspector-substat-item @(isDesired ? "desired" : "")">
                                            <span class="substat-name">@(isDesired ? "★ " : "• ")@Disc.FormatStatName(sub.Stat)</span>
                                            <span class="substat-val">+@Disc.FormatStatValue(sub.Stat, sub.Value)</span>
                                        </li>
                                    }
                                </ul>
                            </div>

                            <div class="inspector-scores-block">
                                <div class="score-metric">
                                    <span class="metric-label">CRIT VALUE</span>
                                    <span class="metric-num">@inspectedStorageDisc.GetCritValue().ToString("0.0")</span>
                                </div>
                                <div class="score-metric">
                                    <span class="metric-label">ROLL VALUE</span>
                                    <span class="metric-num">@inspectedStorageDisc.GetRollValue(Sim.State.DesiredStats) / 4</span>
                                </div>
                            </div>

                            <div class="inspector-actions-block">
                                <button type="button" class="btn-inspector-action danger"
                                        disabled="@inspectedStorageDisc.IsLocked"
                                        @onclick="() => DismantleSingleDisc(inspectedStorageDisc)">
                                    <span>Dismantle (+1 Copy)</span>
                                </button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="inspector-empty">
                            <span>Select a disc to inspect</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
}

@code {
    private ElementReference tuningScreenRef;
    private int selectedPartition = 4;
    private bool showObtainModal = false;
    private bool showStorageModal = false;
    private List<Disc> modalDiscs = new();
    private Disc? inspectedModalDisc;
    private Disc? inspectedStorageDisc;
    private string batteryInputStr = "000240";
    private string etherInputStr = "000012";
    private string hifiInputStr = "000060";
    private SimulationRunResult? lastRunSummary;

    private RoutineCleanupStage GetCurrentStage()
    {
        return RoutineCleanupStage.AllStages.FirstOrDefault(s => s.Id == Sim.State.SelectedCleanupStageId)
               ?? RoutineCleanupStage.AllStages[0];
    }

    private async Task OnStageChanged(ChangeEventArgs e)
    {
        Sim.State.SelectedCleanupStageId = e.Value?.ToString() ?? "predator_prey";
        await SaveState();
    }

    private async Task OnCoffeeToggleChanged(ChangeEventArgs e)
    {
        Sim.State.WithDailyCoffee = (bool)(e.Value ?? false);
        await SaveState();
    }

    private async Task ApplyPreset(int days)
    {
        int chargePerDay = Sim.State.WithDailyCoffee ? 300 : 240;
        Sim.State.BatteryCharge = days * chargePerDay;
        SyncCurrencyInputs();
        await SaveState();
    }

    private int GetTotalCalculatedRuns()
    {
        return (Sim.State.BatteryCharge + (Sim.State.EtherBatteries * 60)) / 60;
    }

    private async Task RunRoutineCleanup()
    {
        // 1. Dump all Ether Batteries into Battery Charge
        if (Sim.State.EtherBatteries > 0)
        {
            Sim.State.BatteryCharge += Sim.State.EtherBatteries * 60;
            Sim.State.EtherBatteries = 0;
        }

        // 2. Compute executable runs
        int runs = Sim.State.BatteryCharge / 60;
        if (runs <= 0) return;

        // 3. Execute simulation
        var result = Sim.RunSimulation(runs * 60);
        lastRunSummary = result;

        // 4. Always show Obtain Modal with all drops
        if (result.GeneratedDiscs.Count > 0)
        {
            modalDiscs = result.GeneratedDiscs;
            inspectedModalDisc = modalDiscs.FirstOrDefault();
            showObtainModal = true;
        }

        SyncCurrencyInputs();
        await SaveState();
    }

    protected override async Task OnInitializedAsync()
    {
        Sim.OnChange += HandleSimStateChanged;

        var savedState = await Storage.LoadStateAsync();
        if (savedState != null)
        {
            Sim.SetState(savedState);
        }
        else
        {
            Sim.State.BatteryCharge = 240;
            Sim.State.EtherBatteries = 12;
            Sim.State.HiFiMasterCopies = 60;
        }

        SyncCurrencyInputs();
    }

    private void HandleSimStateChanged()
    {
        SyncCurrencyInputs();
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await tuningScreenRef.FocusAsync();
            }
            catch { }
        }
    }

    private void SelectPartition(int partition)
    {
        selectedPartition = partition;
        Sim.State.SelectedCraftPartition = partition;
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (int.TryParse(e.Key, out int num) && num >= 1 && num <= 6)
        {
            SelectPartition(num);
        }
        else if (e.Key == "Escape")
        {
            if (showObtainModal) CloseObtainModal();
            else if (showStorageModal) CloseStorageModal();
        }
    }

    private async Task TunePartition(int count)
    {
        int cost = count * SimulationConfig.MasterCopiesPerCraft;
        if (Sim.State.HiFiMasterCopies < cost) return;

        modalDiscs.Clear();
        for (int i = 0; i < count; i++)
        {
            var disc = Sim.CraftSingle(selectedPartition);
            if (disc != null)
            {
                modalDiscs.Add(disc);
            }
        }

        if (modalDiscs.Count > 0)
        {
            inspectedModalDisc = modalDiscs.FirstOrDefault();
            showObtainModal = true;
            await SaveState();
        }
    }

    private void OpenStorageModal()
    {
        showStorageModal = true;
        var filtered = Sim.GetFilteredDiscs();
        inspectedStorageDisc = filtered.FirstOrDefault() ?? Sim.State.Inventory.FirstOrDefault();
    }

    private void CloseStorageModal()
    {
        showStorageModal = false;
    }

    private void SelectStorageDisc(Disc disc)
    {
        inspectedStorageDisc = disc;
    }

    private void ToggleDiscSelection(Disc disc, ChangeEventArgs e)
    {
        disc.IsSelected = (bool)(e.Value ?? false);
    }

    private void SelectAllUnlocked()
    {
        var filtered = Sim.GetFilteredDiscs();
        foreach (var d in filtered.Where(x => !x.IsLocked))
        {
            d.IsSelected = true;
        }
    }

    private void DeselectAll()
    {
        foreach (var d in Sim.State.Inventory)
        {
            d.IsSelected = false;
        }
    }

    private async Task DismantleSelectedDiscs()
    {
        var selected = Sim.State.Inventory.Where(d => d.IsSelected && !d.IsLocked).ToList();
        if (selected.Count > 0)
        {
            Sim.DismantleDiscs(selected);
            var filtered = Sim.GetFilteredDiscs();
            if (inspectedStorageDisc != null && !filtered.Contains(inspectedStorageDisc))
            {
                inspectedStorageDisc = filtered.FirstOrDefault();
            }
            await SaveState();
        }
    }

    private async Task DismantleNonMatchingDiscs()
    {
        int dismantled = Sim.DismantleNonMatching();
        if (dismantled > 0)
        {
            var filtered = Sim.GetFilteredDiscs();
            if (inspectedStorageDisc != null && !filtered.Contains(inspectedStorageDisc))
            {
                inspectedStorageDisc = filtered.FirstOrDefault();
            }
            await SaveState();
        }
    }

    private async Task DismantleSingleDisc(Disc disc)
    {
        if (Sim.DismantleDisc(disc))
        {
            var filtered = Sim.GetFilteredDiscs();
            if (inspectedStorageDisc?.Id == disc.Id)
            {
                inspectedStorageDisc = filtered.FirstOrDefault();
            }
            await SaveState();
        }
    }

    private void SetPartitionFilter(int? partition)
    {
        Sim.State.FilterPartition = partition;
        var filtered = Sim.GetFilteredDiscs();
        if (inspectedStorageDisc != null && !filtered.Contains(inspectedStorageDisc))
        {
            inspectedStorageDisc = filtered.FirstOrDefault();
        }
    }

    private void SetLockFilter(bool? isLocked)
    {
        Sim.State.FilterLock = isLocked;
        var filtered = Sim.GetFilteredDiscs();
        if (inspectedStorageDisc != null && !filtered.Contains(inspectedStorageDisc))
        {
            inspectedStorageDisc = filtered.FirstOrDefault();
        }
    }

    private void OnSetFilterChanged(ChangeEventArgs e)
    {
        var val = e.Value?.ToString();
        Sim.State.FilterSet = string.IsNullOrEmpty(val) ? null : Enum.Parse<DiscSet>(val);
        var filtered = Sim.GetFilteredDiscs();
        if (inspectedStorageDisc != null && !filtered.Contains(inspectedStorageDisc))
        {
            inspectedStorageDisc = filtered.FirstOrDefault();
        }
    }

    private void OnSortChanged(ChangeEventArgs e)
    {
        if (Enum.TryParse<SortOrder>(e.Value?.ToString(), out var sort))
        {
            Sim.State.CurrentSort = sort;
            var filtered = Sim.GetFilteredDiscs();
            if (inspectedStorageDisc != null && !filtered.Contains(inspectedStorageDisc))
            {
                inspectedStorageDisc = filtered.FirstOrDefault();
            }
        }
    }

    private void CloseObtainModal()
    {
        showObtainModal = false;
    }

    private void SelectModalDisc(Disc disc)
    {
        inspectedModalDisc = disc;
    }

    private async Task DismantleModalDisc(Disc disc)
    {
        if (Sim.DismantleDisc(disc))
        {
            modalDiscs.Remove(disc);
            inspectedModalDisc = modalDiscs.FirstOrDefault();
            await SaveState();
        }
    }

    private async Task ToggleLock(Disc disc)
    {
        disc.IsLocked = !disc.IsLocked;
        await SaveState();
    }

    private async Task ResetInitial()
    {
        Sim.Reset();
        Sim.State.BatteryCharge = 240;
        Sim.State.EtherBatteries = 12;
        Sim.State.HiFiMasterCopies = 60;
        selectedPartition = 4;
        inspectedStorageDisc = null;
        lastRunSummary = null;
        showObtainModal = false;
        showStorageModal = false;
        SyncCurrencyInputs();
        await Storage.ClearStateAsync();
        await SaveState();
    }

    private async Task SaveState()
    {
        await Storage.SaveStateAsync(Sim.State);
    }

    private void SyncCurrencyInputs()
    {
        batteryInputStr = FormatDigits(Sim.State.BatteryCharge);
        etherInputStr = FormatDigits(Sim.State.EtherBatteries);
        hifiInputStr = FormatDigits(Sim.State.HiFiMasterCopies);
    }

    private string FormatDigits(int value)
    {
        if (value < 0) value = 0;
        return value.ToString("D6");
    }

    private async void CommitBattery()
    {
        string digitsOnly = new string((batteryInputStr ?? "").Where(char.IsDigit).ToArray());
        if (int.TryParse(digitsOnly, out int val))
        {
            Sim.State.BatteryCharge = Math.Max(0, val);
        }
        else
        {
            Sim.State.BatteryCharge = 0;
        }
        batteryInputStr = FormatDigits(Sim.State.BatteryCharge);
        StateHasChanged();
        await SaveState();
    }

    private async void CommitEther()
    {
        string digitsOnly = new string((etherInputStr ?? "").Where(char.IsDigit).ToArray());
        if (int.TryParse(digitsOnly, out int val))
        {
            Sim.State.EtherBatteries = Math.Max(0, val);
        }
        else
        {
            Sim.State.EtherBatteries = 0;
        }
        etherInputStr = FormatDigits(Sim.State.EtherBatteries);
        StateHasChanged();
        await SaveState();
    }

    private async void CommitHiFi()
    {
        string digitsOnly = new string((hifiInputStr ?? "").Where(char.IsDigit).ToArray());
        if (int.TryParse(digitsOnly, out int val))
        {
            Sim.State.HiFiMasterCopies = Math.Max(0, val);
        }
        else
        {
            Sim.State.HiFiMasterCopies = 0;
        }
        hifiInputStr = FormatDigits(Sim.State.HiFiMasterCopies);
        StateHasChanged();
        await SaveState();
    }

    private void HandleCurrencyKeyDown(KeyboardEventArgs e, Action commitAction)
    {
        if (e.Key == "Enter")
        {
            commitAction();
        }
    }

    private IEnumerable<StatType> GetPossibleMainStats(int partition)
    {
        return partition switch
        {
            1 => new[] { StatType.HP },
            2 => new[] { StatType.ATK },
            3 => new[] { StatType.DEF },
            4 => SimulationConfig.Slot4MainStats,
            5 => SimulationConfig.Slot5MainStats,
            6 => SimulationConfig.Slot6MainStats,
            _ => Array.Empty<StatType>()
        };
    }

    public void Dispose()
    {
        Sim.OnChange -= HandleSimStateChanged;
    }
}
