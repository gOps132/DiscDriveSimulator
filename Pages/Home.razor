@page "/"
@using DiscDriveSimulator.Models
@using DiscDriveSimulator.Services
@inject ISimulationService Sim
@inject StorageService Storage

<PageTitle>Drive Disc Simulator</PageTitle>

<div class="tuning-screen" tabindex="0" @onkeydown="HandleKeyDown" @ref="tuningScreenRef">
    <!-- Top Header Bar -->
    <!-- Top Header Bar Component -->
    <HeaderBar OnOpenStorage="OpenStorageModal" OnReset="ResetInitial" />

    <!-- Main Content Area -->
    <div class="tuning-main-content">
        <!-- Left Column: Routine Cleanup Console & Partition Info -->
        <div class="left-station-column">
            <!-- Routine Cleanup Simulation Console -->
            <section class="routine-cleanup-card">
                <div class="routine-card-header">
                    <div class="routine-title-box">
                        <img src="assets/Item_Battery_Charge.webp" alt="Battery" class="routine-header-icon" />
                        <span class="routine-title">Routine Cleanup</span>
                    </div>
                </div>

                <!-- Stage Selection -->
                <div class="stage-selector-box">
                    <div class="stage-selector-header">
                        <span class="stage-selector-label">Target Stage:</span>
                        <select class="stage-dropdown" value="@Sim.State.SelectedCleanupStageId" @onchange="OnStageChanged">
                            @foreach (var stage in RoutineCleanupStage.AllStages)
                            {
                                <option value="@stage.Id">@stage.Name</option>
                            }
                        </select>
                    </div>
                    @{
                        var currentStage = GetCurrentStage();
                    }
                    <div class="stage-badges-row">
                        <div class="stage-set-card" title="@Disc.FormatSetName(currentStage.Set1)">
                            <DiscSlot Set="currentStage.Set1" ShowPartition="false" Size="48px" />
                            <div class="stage-set-info">
                                <span class="stage-set-name">@Disc.FormatSetName(currentStage.Set1)</span>
                            </div>
                        </div>
                        <div class="stage-set-card" title="@Disc.FormatSetName(currentStage.Set2)">
                            <DiscSlot Set="currentStage.Set2" ShowPartition="false" Size="48px" />
                            <div class="stage-set-info">
                                <span class="stage-set-name">@Disc.FormatSetName(currentStage.Set2)</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Daily Coffee Switch -->
                <div class="coffee-switch-box">
                    <label class="coffee-toggle">
                        <input type="checkbox" checked="@Sim.State.WithDailyCoffee" @onchange="OnCoffeeToggleChanged" />
                        <span class="coffee-slider"></span>
                        <span class="coffee-label">
                            With daily coffee (+60 <img src="assets/Item_Battery_Charge.webp" alt="Charge" class="inline-battery-icon" /> / day)
                        </span>
                    </label>
                </div>

                <!-- Quick Bulk Presets -->
                <div class="preset-buttons-grid">
                    <button type="button" class="btn-preset" @onclick="() => ApplyPreset(1)">
                        <span class="preset-name">1 Day</span>
                        <span class="preset-sub">@(Sim.State.WithDailyCoffee ? "300" : "240")</span>
                    </button>
                    <button type="button" class="btn-preset" @onclick="() => ApplyPreset(7)">
                        <span class="preset-name">1 Week</span>
                        <span class="preset-sub">@(Sim.State.WithDailyCoffee ? "2,100" : "1,680")</span>
                    </button>
                    <button type="button" class="btn-preset" @onclick="() => ApplyPreset(21)">
                        <span class="preset-name">3 Weeks</span>
                        <span class="preset-sub">@(Sim.State.WithDailyCoffee ? "6,300" : "5,040")</span>
                    </button>
                    <button type="button" class="btn-preset" @onclick="() => ApplyPreset(30)">
                        <span class="preset-name">1 Month</span>
                        <span class="preset-sub">@(Sim.State.WithDailyCoffee ? "9,000" : "7,200")</span>
                    </button>
                </div>

                <!-- Stamina & Runs Calculation Box -->
                <div class="stamina-summary-box">
                    <div class="stamina-line">
                        <span class="stamina-label">TOTAL RUNS AVAILABLE</span>
                        <span class="stamina-runs-val">@GetTotalCalculatedRuns() Runs</span>
                    </div>
                    <div class="stamina-sub-details">
                        <span>Charge: @Sim.State.BatteryCharge</span>
                        <span>+ Ether Reserve: @(Sim.State.EtherBatteries * 60)</span>
                    </div>
                </div>

                <!-- Target Partition & Substats Priority -->
                <div class="cleanup-priority-panel">
                    <div class="priority-section-title">Target &amp; Substats Priority</div>

                    <!-- Target Partition Selector -->
                    <div class="priority-row">
                        <div class="target-partition-pills">
                            <button type="button"
                                    class="target-part-pill @(Sim.State.TargetCleanupPartition == null ? "active" : "")"
                                    @onclick="() => SetCleanupTargetPartition(null)">All</button>
                            @for (int p = 1; p <= 6; p++)
                            {
                                var part = p;
                                <button type="button"
                                        class="target-part-pill @(Sim.State.TargetCleanupPartition == part ? "active" : "")"
                                        @onclick="() => SetCleanupTargetPartition(part)">@part</button>
                            }
                        </div>
                    </div>

                    <!-- Ranked Priorities List -->
                    <div class="priority-row">
                        @{
                            var activePriorities = Sim.State.GetActivePrioritizedSubstats();
                            var validPool = SimulationConfig.GetValidSubstatPool(Sim.State.TargetCleanupPartition);
                            var availableStats = validPool.Where(s => !activePriorities.Contains(s)).ToList();
                        }
                        <div class="priority-header-flex">
                            <span class="priority-label">
                                Ranked Priorities @(Sim.State.TargetCleanupPartition.HasValue ? $"(Slot {Sim.State.TargetCleanupPartition.Value})" : "(All Slots)"):
                            </span>
                            @if (activePriorities.Count > 0)
                            {
                                <button type="button" class="btn-clear-priorities" @onclick="ClearPrioritizedSubstats">Clear</button>
                            }
                        </div>

                        <div class="ranked-substats-list">
                            @for (int i = 0; i < activePriorities.Count; i++)
                            {
                                var idx = i;
                                var stat = activePriorities[i];
                                <div class="ranked-chip">
                                    <span class="rank-badge">#@(idx + 1)</span>
                                    <span class="rank-stat-name">@Disc.FormatStatName(stat)</span>
                                    <button type="button" class="rank-remove-btn" @onclick="() => RemovePrioritizedSubstat(idx)" title="Remove">×</button>
                                </div>
                            }
                        </div>

                        <!-- Available Substats to Add -->
                        @if (availableStats.Count > 0)
                        {
                            <div class="available-stats-pool">
                                <span class="pool-hint">+ Add:</span>
                                @foreach (var s in availableStats)
                                {
                                    <button type="button" class="btn-pool-stat" @onclick="() => AddPrioritizedSubstat(s)">
                                        @Disc.FormatStatName(s)
                                    </button>
                                }
                            </div>
                        }
                    </div>

                    <!-- Min RV Threshold -->
                    <div class="priority-row inline-between">
                        <span class="priority-label">Min Roll Value (RV):</span>
                        <div class="rv-stepper">
                            <button type="button" class="btn-rv-step" disabled="@(Sim.State.MinCleanupRv <= 1)" @onclick="DecrementMinRv">-</button>
                            <span class="rv-stepper-val">@Sim.State.MinCleanupRv Rolls</span>
                            <button type="button" class="btn-rv-step" disabled="@(Sim.State.MinCleanupRv >= 5)" @onclick="IncrementMinRv">+</button>
                        </div>
                    </div>
                </div>

                <!-- Automation Settings -->
                <div class="automation-settings-box">
                    <label class="automation-toggle">
                        <input type="checkbox" @bind="Sim.State.AutoDismantleOnSim" />
                        <span>Auto-dismantle non-matching drops</span>
                    </label>
                </div>

                <!-- Single Primary Execution Button -->
                <button type="button" class="btn-run-simulation"
                        disabled="@(GetTotalCalculatedRuns() == 0)"
                        @onclick="RunRoutineCleanup">
                    <span class="btn-sim-text">Start Cleanup</span>
                    <div class="btn-sim-cost">
                        <img src="assets/Item_Battery_Charge.webp" alt="Cost" class="btn-battery-icon" />
                        <span>@(GetTotalCalculatedRuns() * 60)</span>
                    </div>
                </button>

                <!-- Bulk Run Result Summary Banner (if executed) -->
                @if (lastRunSummary != null)
                {
                    <div class="run-summary-banner">
                        <div class="summary-topline">
                            <span class="summary-runs">Completed @lastRunSummary.Runs Runs</span>
                        </div>
                        <div class="summary-stats-grid">
                            <div class="sum-stat">
                                <span class="sum-label">DROPS</span>
                                <span class="sum-val">@lastRunSummary.GeneratedDiscs.Count</span>
                            </div>
                            <div class="sum-stat">
                                <span class="sum-label">KEPT</span>
                                <span class="sum-val highlight">@lastRunSummary.KeptDiscs.Count</span>
                            </div>
                            <div class="sum-stat">
                                <span class="sum-label">DISMANTLED</span>
                                <span class="sum-val">@lastRunSummary.DismantledCount</span>
                            </div>
                            <div class="sum-stat">
                                <span class="sum-label">AVG CV</span>
                                <span class="sum-val">@lastRunSummary.AverageCv</span>
                            </div>
                        </div>
                    </div>
                }

                <!-- Lifetime Farming Statistics -->
                <div class="routine-lifetime-stats">
                    <div class="lifetime-stat-item">
                        <span class="lbl">Runs</span>
                        <span class="val">@Sim.State.TotalRuns</span>
                    </div>
                    <div class="lifetime-stat-item">
                        <span class="lbl">Spent</span>
                        <span class="val">@Sim.State.TotalBatterySpent</span>
                    </div>
                    <div class="lifetime-stat-item">
                        <span class="lbl">Drops</span>
                        <span class="val">@Sim.State.TotalDiscsDropped</span>
                    </div>
                    <div class="lifetime-stat-item">
                        <span class="lbl">Dismantled</span>
                        <span class="val">@Sim.State.TotalDiscsDismantled</span>
                    </div>
                </div>
            </section>
        </div>

        <div class="bardic-needle-container ">
            <!-- Center Floating Partition Info Card -->
            <aside class="partition-info-card">
                <!-- Target Disc Set Selector Row -->
                <div class="target-disc-set-box" @onclick="OpenDiscSelectorModal" title="Click to choose Drive Disc type">
                    <img src="@Disc.GetDiscImagePath(selectedCraftSet)" alt="@Disc.FormatSetName(selectedCraftSet)" class="target-disc-thumb" />
                    <div class="target-disc-text-group">
                        <span class="target-disc-label">Target Drive Disc</span>
                        <span class="target-disc-name">@Disc.FormatSetName(selectedCraftSet)</span>
                    </div>
                </div>

                <div class="info-card-divider"></div>

                @if (selectedPartition.HasValue)
                {
                    <div class="info-title">Partition @selectedPartition.Value (Selected)</div>
                    <div class="info-subtitle">Possible Main Stats:</div>
                    <ul class="stats-pool-list">
                        @foreach (var stat in GetPossibleMainStats(selectedPartition.Value))
                        {
                            <li>@Disc.FormatStatName(stat)</li>
                        }
                    </ul>
                }
                else
                {
                    <div class="info-title">Random Partition</div>
                    <div class="info-summary-text">
                        Any Partition
                    </div>
                }
            </aside>

            <!-- Right Main Console -->
            <main class="tuning-console-panel">
                <div class="console-prompt-banner">
                    Press the number to select a Drive Disc partition
                </div>

                <!-- Circular Apparatus with 6 Interactive Sockets -->
                <div class="apparatus-wrapper">
                    <img src="assets/Equipment_Menu_Screen.webp" alt="Tuning Apparatus" class="apparatus-bg" />

                    @for (int i = 1; i <= 6; i++)
                    {
                        var partitionNumber = i;
                        <button type="button"
                                class="socket-node socket-@partitionNumber @(selectedPartition == partitionNumber ? "selected" : "")"
                                title="Partition @partitionNumber"
                                @onclick="() => SelectPartition(partitionNumber)">
                            <span class="socket-label">@partitionNumber</span>
                        </button>
                    }
                </div>

                <div class="console-notice-text">
                    @(selectedPartition.HasValue
                        ? $"Guaranteed S-Rank {Disc.FormatSetName(selectedCraftSet)} Drive Disc for Partition {selectedPartition.Value}"
                        : $"Guaranteed S-Rank {Disc.FormatSetName(selectedCraftSet)} Drive Disc for a random partition (1-6)")
                </div>

                <!-- Action Buttons: Tune x01 & Tune x10 -->
                <div class="tune-buttons-row">
                    <button type="button" class="btn-tune"
                            disabled="@(Sim.State.HiFiMasterCopies < 6)"
                            @onclick="() => TunePartition(1)">
                        <div class="tune-cost-group">
                            <img src="assets/Item_Hi-Fi_Master_Copy.webp" alt="Cost" class="tune-cost-icon" />
                            <span>6</span>
                        </div>
                        <div class="tune-label-group">
                            <span class="tune-sub-text">@(selectedPartition.HasValue ? $"Tune Partition {selectedPartition.Value}" : "Tune Random Partition")</span>
                            <span class="tune-multiplier">x01</span>
                        </div>
                    </button>

                    <button type="button" class="btn-tune"
                            disabled="@(Sim.State.HiFiMasterCopies < 60)"
                            @onclick="() => TunePartition(10)">
                        <div class="tune-cost-group">
                            <img src="assets/Item_Hi-Fi_Master_Copy.webp" alt="Cost" class="tune-cost-icon" />
                            <span>60</span>
                        </div>
                        <div class="tune-label-group">
                            <span class="tune-sub-text">@(selectedPartition.HasValue ? $"Tune Partition {selectedPartition.Value}" : "Tune Random Partition")</span>
                            <span class="tune-multiplier">x10</span>
                        </div>
                    </button>
                </div>
            </main>
        </div>

        
    </div>

    <!-- Screen Footer -->
    <footer class="tuning-footer">
        <span>UID: CEDRAKE</span>
    </footer>
</div>

<!-- ==========================================================================
     "OBTAIN" MODAL POPUP
     ========================================================================== -->
<ObtainModal IsOpen="showObtainModal"
             Source="@obtainModalSource"
             Discs="modalDiscs"
             RunSummary="lastRunSummary"
             OnClose="CloseObtainModal" />


<!-- ==========================================================================
     STORAGE & INVENTORY MODAL
     ========================================================================== -->
<StorageModal IsOpen="showStorageModal" OnClose="CloseStorageModal" />


@if (showDiscSelectorModal)
{
    <div class="modal-backdrop-overlay" @onclick="CloseDiscSelectorModal">
        <div class="disc-selector-modal" @onclick:stopPropagation="true">
            <div class="disc-selector-header">
                <div class="disc-selector-title">Select Target Drive Disc</div>
                <button type="button" class="obtain-close-btn" @onclick="CloseDiscSelectorModal" title="Close">
                    <img src="assets/IconCancel.png" alt="Close" />
                </button>
            </div>

            <div class="disc-selector-search-box">
                <input type="text"
                       class="disc-selector-search-input"
                       placeholder="Search drive disc by name..."
                       value="@discSearchQuery"
                       @oninput="(e) => discSearchQuery = e.Value?.ToString() ?? string.Empty" />
            </div>

            <div class="disc-selector-grid">
                @foreach (var set in FilteredDiscSets)
                {
                    var isCurrent = selectedCraftSet == set;
                    <div class="disc-selector-item @(isCurrent ? "selected" : "")"
                         @onclick="() => SelectDiscSet(set)">
                        <img src="@Disc.GetDiscImagePath(set)" alt="@Disc.FormatSetName(set)" class="disc-selector-item-img" />
                        <span class="disc-selector-item-name">@Disc.FormatSetName(set)</span>
                    </div>
                }
            </div>
        </div>
    </div>
}

@code {
    private ElementReference tuningScreenRef;
    private int? selectedPartition = null;
    private DiscSet selectedCraftSet = DiscSet.SwingJazz;
    private bool showDiscSelectorModal = false;
    private string discSearchQuery = string.Empty;

    private static readonly DiscSet[] AllSelectableSets = Enum.GetValues<DiscSet>()
        .Where(s => s != DiscSet.SetAlpha && s != DiscSet.SetBeta)
        .ToArray();

    private IEnumerable<DiscSet> FilteredDiscSets =>
        string.IsNullOrWhiteSpace(discSearchQuery)
            ? AllSelectableSets
            : AllSelectableSets.Where(s => Disc.FormatSetName(s).Contains(discSearchQuery, StringComparison.OrdinalIgnoreCase));

    private bool showObtainModal = false;
    private string obtainModalSource = "ROUTINE";
    private bool showStorageModal = false;
    private List<Disc> modalDiscs = new();
    private SimulationRunResult? lastRunSummary;

    private RoutineCleanupStage GetCurrentStage()
    {
        return RoutineCleanupStage.AllStages.FirstOrDefault(s => s.Id == Sim.State.SelectedCleanupStageId)
               ?? RoutineCleanupStage.AllStages[0];
    }

    private async Task OnStageChanged(ChangeEventArgs e)
    {
        Sim.State.SelectedCleanupStageId = e.Value?.ToString() ?? "stage_1";
        await SaveState();
    }

    private async Task OnCoffeeToggleChanged(ChangeEventArgs e)
    {
        Sim.State.WithDailyCoffee = (bool)(e.Value ?? false);
        await SaveState();
    }

    private async Task ApplyPreset(int days)
    {
        int chargePerDay = Sim.State.WithDailyCoffee ? 300 : 240;
        Sim.State.BatteryCharge = days * chargePerDay;
        Sim.NotifyStateChanged();
        await SaveState();
    }

    private int GetTotalCalculatedRuns()
    {
        return (Sim.State.BatteryCharge + (Sim.State.EtherBatteries * 60)) / 60;
    }

    private async Task SetCleanupTargetPartition(int? partition)
    {
        Sim.State.TargetCleanupPartition = partition;
        Sim.State.SanitizePriorities();
        await SaveState();
    }

    private async Task AddPrioritizedSubstat(StatType stat)
    {
        var active = Sim.State.GetActivePrioritizedSubstats();
        if (!active.Contains(stat))
        {
            active.Add(stat);
            await SaveState();
        }
    }

    private async Task RemovePrioritizedSubstat(int index)
    {
        var active = Sim.State.GetActivePrioritizedSubstats();
        if (index >= 0 && index < active.Count)
        {
            active.RemoveAt(index);
            await SaveState();
        }
    }

    private async Task ClearPrioritizedSubstats()
    {
        var active = Sim.State.GetActivePrioritizedSubstats();
        active.Clear();
        await SaveState();
    }

    private async Task IncrementMinRv()
    {
        if (Sim.State.MinCleanupRv < 5)
        {
            Sim.State.MinCleanupRv++;
            await SaveState();
        }
    }

    private async Task DecrementMinRv()
    {
        if (Sim.State.MinCleanupRv > 1)
        {
            Sim.State.MinCleanupRv--;
            await SaveState();
        }
    }

    private async Task RunRoutineCleanup()
    {
        // 1. Dump all Ether Batteries into Battery Charge
        if (Sim.State.EtherBatteries > 0)
        {
            Sim.State.BatteryCharge += Sim.State.EtherBatteries * 60;
            Sim.State.EtherBatteries = 0;
        }

        // 2. Compute executable runs
        int runs = Sim.State.BatteryCharge / 60;
        if (runs <= 0) return;

        // 3. Execute simulation
        var result = Sim.RunSimulation(runs * 60);
        lastRunSummary = result;

        // 4. Always show Obtain Modal with all drops
        if (result.GeneratedDiscs.Count > 0)
        {
            obtainModalSource = "ROUTINE";
            modalDiscs = result.GeneratedDiscs;
            showObtainModal = true;
        }

        await SaveState();
    }

    protected override async Task OnInitializedAsync()
    {
        Sim.OnChange += HandleSimStateChanged;

        var savedState = await Storage.LoadStateAsync();
        if (savedState != null)
        {
            Sim.SetState(savedState);
            selectedPartition = Sim.State.SelectedCraftPartition;
            selectedCraftSet = Sim.State.SelectedCraftSet;
        }
        else
        {
            Sim.State.BatteryCharge = 240;
            Sim.State.EtherBatteries = 0;
            Sim.State.HiFiMasterCopies = 0;
        }
    }

    private void HandleSimStateChanged()
    {
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                await tuningScreenRef.FocusAsync();
            }
            catch { }
        }
    }

    private void SelectPartition(int partition)
    {
        if (selectedPartition == partition)
        {
            selectedPartition = null;
            Sim.State.SelectedCraftPartition = null;
        }
        else
        {
            selectedPartition = partition;
            Sim.State.SelectedCraftPartition = partition;
        }
    }

    private void OpenDiscSelectorModal()
    {
        discSearchQuery = string.Empty;
        showDiscSelectorModal = true;
        StateHasChanged();
    }

    private void CloseDiscSelectorModal()
    {
        showDiscSelectorModal = false;
        StateHasChanged();
    }

    private async Task SelectDiscSet(DiscSet set)
    {
        selectedCraftSet = set;
        Sim.State.SelectedCraftSet = set;
        showDiscSelectorModal = false;
        await SaveState();
        Sim.NotifyStateChanged();
    }

    private void HandleKeyDown(KeyboardEventArgs e)
    {
        if (int.TryParse(e.Key, out int num) && num >= 1 && num <= 6)
        {
            SelectPartition(num);
        }
        else if (e.Key == "Escape")
        {
            if (showDiscSelectorModal) CloseDiscSelectorModal();
            else if (showObtainModal) CloseObtainModal();
            else if (showStorageModal) CloseStorageModal();
        }
    }

    private async Task TunePartition(int count)
    {
        int cost = count * SimulationConfig.MasterCopiesPerCraft;
        if (Sim.State.HiFiMasterCopies < cost) return;

        modalDiscs.Clear();
        for (int i = 0; i < count; i++)
        {
            var disc = Sim.CraftSingle(selectedPartition, selectedCraftSet);
            if (disc != null)
            {
                modalDiscs.Add(disc);
            }
        }

        if (modalDiscs.Count > 0)
        {
            obtainModalSource = "TUNING";
            showObtainModal = true;
            await SaveState();
        }
    }

    private void OpenStorageModal()
    {
        showStorageModal = true;
    }

    private void CloseStorageModal()
    {
        showStorageModal = false;
    }

    private void CloseObtainModal()
    {
        showObtainModal = false;
    }

    private async Task ResetInitial()
    {
        Sim.Reset();
        Sim.State.BatteryCharge = 240;
        Sim.State.EtherBatteries = 0;
        Sim.State.HiFiMasterCopies = 0;
        selectedPartition = null;
        Sim.State.SelectedCraftPartition = null;
        selectedCraftSet = DiscSet.SwingJazz;
        Sim.State.SelectedCraftSet = DiscSet.SwingJazz;
        Sim.State.SelectedCleanupStageId = "stage_1";
        lastRunSummary = null;
        showObtainModal = false;
        showStorageModal = false;
        Sim.NotifyStateChanged();
        await Storage.ClearStateAsync();
        await SaveState();
    }

    private async Task SaveState()
    {
        await Storage.SaveStateAsync(Sim.State);
    }

    private IEnumerable<StatType> GetPossibleMainStats(int partition)
    {
        return partition switch
        {
            1 => new[] { StatType.HP },
            2 => new[] { StatType.ATK },
            3 => new[] { StatType.DEF },
            4 => SimulationConfig.Slot4MainStats,
            5 => SimulationConfig.Slot5MainStats,
            6 => SimulationConfig.Slot6MainStats,
            _ => Array.Empty<StatType>()
        };
    }

    public void Dispose()
    {
        Sim.OnChange -= HandleSimStateChanged;
    }
}
